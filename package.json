{
  "name": "jspsych-ai-research",
  "version": "0.3.0",
  "description": "Standalone AI research plugins for jsPsych 7.3.4",
  "repository": { "type": "git", "url": "git+https://github.com/MAX7107118046/jspsych-ai-research.git" },
  "homepage": "https://github.com/MAX7107118046/jspsych-ai-research#readme",
  "bugs": { "url": "https://github.com/MAX7107118046/jspsych-ai-research/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./research": { "types": "./dist/research/public.d.ts", "import": "./dist/research.js" },
    "./speech": { "types": "./dist/speech/index.d.ts", "import": "./dist/speech.js" },
    "./cloudpsych": {
      "types": "./dist/cloudpsych.d.ts",
      "import": "./dist/cloudpsych.js"
    },
    "./cloudpsych/module": "./integrations/cloudpsych.mjs",
    "./style.css": "./dist/style.css",
    "./browser": "./dist/jspsych-ai.browser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "server",
    "integrations",
    "scripts/verify-*.mjs",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:research": "node test/research-browser.mjs",
    "test:voice:live": "node test/voice-live.mjs",
    "test:live": "node scripts/verify-live.mjs",
    "test:providers": "node scripts/verify-providers.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run test:research",
    "start": "node server/dev.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "jspsych": "7.3.4"
  },
  "dependencies": {
    "@jspsych/plugin-survey-text": "1.1.3",
    "ajv": "8.17.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@jspsych/plugin-html-button-response": "1.2.0",
    "@jspsych/plugin-html-keyboard-response": "1.1.3",
    "@jspsych/plugin-image-keyboard-response": "1.1.3",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jspsych": "7.3.4",
    "playwright": "1.59.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/style.css"
  ]
}
